# Vite thay thế mọi biến VITE_* NGAY LÚC BUILD, không đọc lúc chạy. Sửa file này
# xong phải chạy lại dev server / build lại thì giá trị mới có hiệu lực.
#
# Mọi giá trị ở đây đều nằm trong bundle JS công khai → KHÔNG BAO GIỜ đặt secret
# vào biến VITE_*. Client secret của Google/GitHub chỉ nằm ở backend.

# Gốc API của backend, đã gồm API_PREFIX. Backend chạy local mặc định cổng 9999.
VITE_API_BASE_URL=http://localhost:9999/api/v1

# Social login. Phải TRÙNG KHÍT GOOGLE_CLIENT_ID / GITHUB_CLIENT_ID của backend —
# lệch một ký tự thì backend đổi code thất bại với Error.InvalidAuthorizationCode.
# Để trống thì nút Google/GitHub báo "social sign-in is unavailable".
#
# Redirect URI tương ứng, phải khai y hệt ở CẢ BA nơi (backend
# OAUTH_REDIRECT_URI_ALLOWLIST, Google Cloud Console, GitHub OAuth App):
#   http://localhost:3000/auth/google/callback
#   http://localhost:3000/auth/github/callback
# Cổng 3000 là bắt buộc — vite.config.js khoá strictPort đúng vì lý do này.
VITE_GOOGLE_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=
